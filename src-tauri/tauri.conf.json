{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remi",
  "version": "0.1.0",
  "identifier": "dev.remi.personal-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet-window",
        "title": "Remi",
        "width": 200,
        "height": 200,
        "minWidth": 128,
        "minHeight": 128,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "chat-bubble-window",
        "title": "Remi Chat",
        "width": 320,
        "height": 176,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings-window",
        "title": "Remi Settings",
        "width": 700,
        "height": 520,
        "minWidth": 640,
        "minHeight": 480,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
